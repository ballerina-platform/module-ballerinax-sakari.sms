    string phoneNumber?;
    # Price charged for the message
    decimal price?;
    # A contact in the Sakari address book
    Contact contact?;
    # Unique identifier of the message
    string id;
    # Date and time the message is scheduled to be sent
    string sendAt?;
    # Audit information recording when and by whom a record was changed
    Updated updated?;
    # A message thread between the account and a single contact
    Conversation conversation?;
    # A group of phone numbers, senders and users that send and receive messages together
    Group group?;
    # Delivery status of the message
    string status;
};

# Maps a column of an uploaded file to a contact attribute
public type FieldMapping record {
    # Column in the uploaded file
    string column?;
    # Contact attribute the column maps to
    string attribute?;
    # Whether the column must have a value
    boolean mandatory?;
};

# Selects the phone numbers the message is sent from
public type SendMessagesRequestPhoneNumberFilter record {
    # Group whose phone numbers send the message
    SendMessagesRequestPhoneNumberFilterGroup group?;
};

# Constraints on the days and time at which the delay ends
public type AdvancedDelayAdditionalTime record {
    # Time zone used for the day and time constraints
    string timezone?;
    # Days of the week on which a delayed step may continue
    AdvancedDelayDays days?;
    # Time of day at which a delayed step continues
    AdvancedDelayTime time?;
};

# Registered messaging campaign
public type SmsRegulatoryCampaign record {
    # Use case of the registered campaign
    string useCase?;
    # Campaign ID assigned by the registry
    string campaignId?;
    # Unique identifier of the registered campaign
    string id?;
};

# Represents the Queries record for the operation: listLinkSources
public type ListLinkSourcesQueries record {
    # Sources to analyse
    string sources?;
};

# SMS channel settings for a phone number or sender
public type SmsChannel record {
    *Channel;
    # Carrier registration details for sending SMS from a phone number
    SmsRegulatory regulatory?;
    # Whether universal reply is enabled for the SMS channel
    boolean universalReply?;
    # Map of destination countries to whether messages can be sent to them
    SupportedDestinations supportedDestinations?;
};

# Type of an edge connecting two workflow nodes
public type WorkflowEdgeType "standard"|"timeout"|"error";

# Rules for the outgoing edges a workflow node type must have
public type WorkflowNodeTypeValidation record {
    # Required number of edges
    decimal numEdges?;
    # Rules for each outgoing edge
    EdgeValidation[] edges?;
    # How the number of edges is compared with the required count
    NumEdgeConditions numEdgeCondition?;
};

# Response containing the short link to a shared file
public type ShareFileResponse record {
    *BasicResponse;
    # Details of the shared file
    ShareFileResponse_data data;
};

# How incoming calls are handled
public type VoiceChannel_incoming record {
    # Whether voicemails are transcribed.
    boolean transcribe?;
    # Action taken for incoming calls.
    "forward"|"voicemail" action?;
    # Phone number incoming calls are forwarded to.
    string forwardTo?;
    # Message played to callers.
    string message?;
};

# Configuration of a trigger that starts a workflow when a form is submitted
public type FormSubmittedTriggerConfig record {
    # A web form that collects contact sign-ups
    Form form?;
};

# Details of the shared file
public type ShareFileResponse_data record {
    # Date and time the link expires.
    string expires?;
    # Short link to the shared file.
    string link;
};

# A contact in the Sakari address book
public type Contact record {
    *Person;
    # Unique identifier of the contact
    string id;
    # Whether the contact's details are valid
    boolean valid?;
    # Link to the matching ActiveCampaign record
    Contact_activecampaign activecampaign?;
    # Date and time the contact was blocked
    string blocked?;
    # Lists the contact belongs to
    ContactList[] lists?;
    # Audit information recording when and by whom a record was changed
    Updated created?;
    # Date and time the contact opted in to messages
    string optIn?;
    # Link to the matching Pipedrive record
    Contact_pipedrive pipedrive?;
    # Custom attributes of the contact
    record {} attributes?;
    # An error reported by the API, with a code and a human-readable description
    ApiError 'error?;
    # Link to the matching HubSpot record
    Contact_hubspot hubspot?;
    # Audit information recording when and by whom a record was changed
    Updated updated?;
};

# Configuration of a trigger that starts a workflow when a message is received
public type MessageReceivedTriggerConfig record {
    # Groups whose received messages trigger the workflow
    Group[] groups?;
    # Message text that triggers the workflow
    string message?;
};

# Criteria that select which contacts a campaign is sent to
public type CampaignFilter record {
    # Search term that contacts must match
    string q?;
    # Attribute conditions that contacts must meet
    Condition[] attributes?;
    # Contact list to send to, either as a list object or a list ID
    List|string list?;
    # Tags used to select contacts
    CampaignFilterTags[] tags?;
};

# Link to the matching HubSpot record
public type Contact_hubspot record {
    # ID of the contact in HubSpot.
    decimal id?;
};

# Maps a value to a column in a Google Sheets tab
public type GoogleSheetColumnMapping record {
    # A column in a Google Sheets tab
    GoogleSheetColumn column?;
    # Value written to the column
    string value?;
};

# Weekly schedule of time ranges, listed per day of the week
public type Times record {
    # Time ranges on Thursday
    Hours[] thu?;
    # Time ranges on Tuesday
    Hours[] tue?;
    # Time ranges on Wednesday
    Hours[] wed?;
    # Time ranges on Saturday
    Hours[] sat?;
    # Time ranges on Friday
    Hours[] fri?;
    # Time ranges on Sunday
    Hours[] sun?;
    # Time ranges on Monday
    Hours[] mon?;
};

# Response containing a single workflow
public type WorkflowResponse record {
    *BasicResponse;
    # An automated workflow and its versions
    Workflow data;
};

# Paginated response containing the click sources of a tracked link
public type LinkSourcesResponse record {
    *PaginatedResponse;
    # The link sources in this page of results
    LinkSource[] data;
};
