    #
    # + accountId - Account to apply operations to
    # + dripCampaignId - Drip Campaign to apply operations to
    # + headers - Headers to be sent with the request 
    # + return - The workflow created from the drip campaign 
    remote isolated function migrateDripCampaignToWorkflow(string accountId, string dripCampaignId, map<string|string[]> headers = {}) returns WorkflowResponse|error {
        string resourcePath = string `/accounts/${getEncodedUri(accountId)}/dripcampaigns/${getEncodedUri(dripCampaignId)}/migrate`;
