    remote isolated function updateDripCampaign(string accountId, string dripCampaignId, CreateUpdateDripCampaign payload, map<string|string[]> headers = {}) returns DripCampaignResponse|error {
        string resourcePath = string `/accounts/${getEncodedUri(accountId)}/dripcampaigns/${getEncodedUri(dripCampaignId)}`;
        http:Request request = new;
        json jsonBody = jsondata:toJson(payload);
        request.setPayload(jsonBody, "application/json");
        return self.clientEp->put(resourcePath, request, headers);
    }

    # Deletes a drip campaign
