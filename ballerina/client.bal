    remote isolated function deleteDripCampaign(string accountId, string dripCampaignId, map<string|string[]> headers = {}) returns SuccessResponse|error {
        string resourcePath = string `/accounts/${getEncodedUri(accountId)}/dripcampaigns/${getEncodedUri(dripCampaignId)}`;
        return self.clientEp->delete(resourcePath, headers = headers);
    }

