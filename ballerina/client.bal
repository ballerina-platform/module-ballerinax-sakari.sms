    # Fetch executions for dripcampaigns
    #
    # + accountId - Account to apply operations to
    # + dripCampaignId - Drip Campaign to apply operations to
    # + headers - Headers to be sent with the request 
    # + queries - Queries to be sent with the request 
    # + return - The executions of the drip campaign 
    remote isolated function listDripCampaignExecutions(string accountId, string dripCampaignId, map<string|string[]> headers = {}, *ListDripCampaignExecutionsQueries queries) returns DripCampaignExecutionsResponse|error {
        string resourcePath = string `/accounts/${getEncodedUri(accountId)}/dripcampaigns/${getEncodedUri(dripCampaignId)}/executions`;
        resourcePath = resourcePath + check getPathForQueryParam(queries);
        return self.clientEp->get(resourcePath, headers);
    }
